---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeInit from '../components/ThemeInit.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "PeterYang's tech blog" } = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL('/avatar.jpg', siteUrl);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeInit />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | PeterYang`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:type" content="website" />
    <title>{title} | PeterYang</title>
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" type="application/rss+xml" title="PeterYang RSS" href={new URL('/rss.xml', siteUrl).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="bg-ambient bg-ambient-1" aria-hidden="true"></div>
    <div class="bg-ambient bg-ambient-2" aria-hidden="true"></div>
    <div class="bg-ambient bg-ambient-3" aria-hidden="true"></div>

    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
