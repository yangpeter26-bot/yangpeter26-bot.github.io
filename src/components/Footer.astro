---
import { site } from '../config/site';
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-identity"><a href="/">{site.name}<span aria-hidden="true">.</span></a><p>在这里，留下一点思考。</p></div>
    <div class="footer-end">
      <nav class="footer-links" aria-label="联系与订阅"><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href="/rss.xml">RSS</a><a href={`mailto:${site.email}`}>联系</a></nav>
      <p>© {new Date().getFullYear()} {site.name}<span class="footer-dot" aria-hidden="true">·</span>记录，学习，继续向前。</p>
    </div>
  </div>
</footer>
<style>
  .site-footer { position: relative; margin: 80px auto 0; padding: 0 32px 32px; max-width: 1184px; color: var(--text-tertiary); }
  .footer-inner { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; border-top: 1px solid var(--border); padding-top: 30px; }
  .footer-identity > a { color: var(--text); font-weight: 750; font-size: 27px; letter-spacing: -.065em; text-decoration: none; }
  .footer-identity > a span { color: var(--blue); }
  .footer-identity p { margin: 8px 0 0; font-size: 12px; }
  .footer-end { text-align: right; }
  .footer-links { display: flex; justify-content: flex-end; gap: 24px; margin-bottom: 14px; }
  .footer-links a { min-height: 30px; display: inline-flex; align-items: center; gap: 4px; color: var(--text-secondary); font-size: 12px; text-decoration: none; }
  .footer-links a:hover { color: var(--blue); }
  .footer-links a span { font-size: 11px; }
  .footer-end p { margin: 0; font-size: 11px; }
  .footer-dot { margin: 0 8px; }
  @media (max-width: 680px) {
    .site-footer { margin-top: 60px; padding: 0 22px 28px; }
    .footer-inner { align-items: flex-start; padding-top: 24px; }
    .footer-links { gap: 18px; margin-bottom: 8px; }
    .footer-links a { min-height: 44px; }
    .footer-end p { max-width: 175px; line-height: 1.9; }
    .footer-dot { display: block; font-size: 0; height: 0; }
  }
</style>
