---
import { site } from '../config/site';
const navigation = [
  { href: '/', text: '首页' }, { href: '/archive/', text: '文章' },
  { href: '/posts/about/', text: '关于' }, { href: '/posts/guestbook/', text: '留言' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const normalized = href.replace(/\/$/, '') || '/';
  if (normalized === '/archive') return currentPath === normalized || (currentPath.startsWith('/posts/') && !['/posts/about', '/posts/guestbook'].includes(currentPath));
  return normalized === currentPath;
};
---

<header class="site-header">
  <nav class="navigation glass" aria-label="主导航">
    <a href="/" class="brand" aria-label={`${site.name}，返回首页`}>
      <span class="brand-mark" aria-hidden="true">y</span><span>{site.name}</span>
    </a>
    <ul class="desktop-links">
      {navigation.map(({ href, text }) => (
        <li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{text}</a></li>
      ))}
    </ul>
    <div class="nav-actions">
      <button type="button" class="nav-action search-trigger" aria-label="搜索文章" aria-haspopup="dialog" aria-controls="search-dialog" data-search-open>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
      </button>
      <button type="button" class="nav-action theme-button" id="theme-toggle" aria-label="切换深色主题" aria-pressed="false">
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 13.5A8.5 8.5 0 0 1 10.5 3.5a8.5 8.5 0 1 0 10 10Z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
      </button>
      <button type="button" class="nav-action menu-toggle" id="hamburger" aria-label="展开导航" aria-controls="mobile-menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="menu-line-top" d="M5 8h14"/><path class="menu-line-bottom" d="M5 16h14"/></svg>
      </button>
    </div>
    <ul class="mobile-navigation glass" id="mobile-menu" hidden>
      {navigation.map(({ href, text }) => (
        <li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{text}<span aria-hidden="true">↗</span></a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header { position: sticky; top: 18px; z-index: 100; width: min(680px, calc(100% - 40px)); margin: 18px auto 0; }
  .navigation { position: relative; display: flex; align-items: center; gap: 18px; padding: 7px 9px; border-radius: 999px; overflow: visible; }
  .brand { display: inline-flex; align-items: center; gap: 9px; padding: 0 12px 0 3px; color: var(--text); text-decoration: none; font-size: 18px; font-weight: 700; letter-spacing: -.06em; white-space: nowrap; min-height: 44px; }
  .brand-mark { display: grid; place-items: center; width: 33px; height: 33px; border-radius: 50%; font-size: 23px; font-weight: 600; line-height: 1; padding-bottom: 4px; color: #346799; background: linear-gradient(145deg, #fff 0%, #dcebf8 100%); box-shadow: inset 0 1px 1px #fff, 0 2px 5px #2b5b8520; }
  .desktop-links { display: flex; align-items: center; justify-content: center; gap: 3px; list-style: none; margin: 0; padding: 0; flex: 1; }
  .desktop-links a { display: flex; align-items: center; justify-content: center; min-height: 42px; padding: 0 17px; border-radius: 999px; font-size: 13px; font-weight: 600; color: var(--text-secondary); text-decoration: none; white-space: nowrap; transition: background .2s, color .2s, box-shadow .2s; }
  .desktop-links a:hover { color: var(--text); background: rgb(255 255 255 / .35); }
  .desktop-links a[aria-current="page"] { color: var(--blue); background: rgb(255 255 255 / .76); box-shadow: inset 0 1px 0 rgb(255 255 255 / .95), 0 2px 8px #3c53600d; }
  .nav-actions { display: flex; align-items: center; gap: 1px; }
  .nav-action { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; color: var(--text-secondary); background: transparent; cursor: pointer; transition: color .2s, background .2s; }
  .nav-action:hover { color: var(--blue); background: rgb(255 255 255 / .52); }
  .nav-action svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .icon-sun { display: none; }
  :global(html[data-theme="dark"]) .icon-moon { display: none; }
  :global(html[data-theme="dark"]) .icon-sun { display: block; }
  :global(html[data-theme="dark"]) .brand-mark { color: #bbdbf8; background: linear-gradient(145deg, #46627b, #25394d); box-shadow: inset 0 1px 0 #ffffff38, 0 2px 5px #0003; }
  :global(html[data-theme="dark"]) .desktop-links a[aria-current="page"] { background: rgb(255 255 255 / .11); box-shadow: inset 0 1px 0 #ffffff21, 0 2px 8px #0001; }
  :global(html[data-theme="dark"]) .desktop-links a:hover, :global(html[data-theme="dark"]) .nav-action:hover { background: rgb(255 255 255 / .07); }
  .menu-toggle, .mobile-navigation { display: none; }
  :global(html:not(.js)) .search-trigger, :global(html:not(.js)) .theme-button { display: none; }
  @media (max-width: 680px) {
    .site-header { top: 12px; width: calc(100% - 32px); margin-top: 12px; }
    .navigation { gap: 6px; padding: 5px 7px; justify-content: space-between; }
    .brand { padding-right: 5px; }
    .desktop-links { display: none; }
    :global(html.js) .menu-toggle { display: grid; }
    .mobile-navigation:not([hidden]) { display: flex; flex-direction: column; position: absolute; top: calc(100% + 10px); left: 0; right: 0; margin: 0; list-style: none; padding: 8px; border-radius: 27px; }
    .mobile-navigation a { display: flex; justify-content: space-between; align-items: center; min-height: 49px; padding: 0 18px; border-radius: 19px; text-decoration: none; color: var(--text-secondary); font-size: 15px; }
    .mobile-navigation a[aria-current="page"] { background: rgb(115 166 208 / .13); color: var(--blue); font-weight: 600; }
    .mobile-navigation a span { font-size: 18px; opacity: .5; }
    .menu-line-top, .menu-line-bottom { transform-origin: center; transition: transform .2s; }
    .menu-toggle[aria-expanded="true"] .menu-line-top { transform: translateY(4px) rotate(45deg); }
    .menu-toggle[aria-expanded="true"] .menu-line-bottom { transform: translateY(-4px) rotate(-45deg); }
    :global(html:not(.js)) .navigation { flex-wrap: wrap; }
    :global(html:not(.js)) .desktop-links { display: flex; flex: 1; gap: 0; }
    :global(html:not(.js)) .desktop-links a { padding: 0 9px; }
  }
</style>
