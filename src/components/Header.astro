---
import { site } from '../config/site';

const navigation = [
  { href: '/', text: '首页', icon: '<path d="m3.5 10.5 8.5-7 8.5 7"/><path d="M5.5 9v11h5v-6h3v6h5V9"/>' },
  { href: '/archive/', text: '文章', icon: '<rect x="5" y="3.5" width="14" height="17" rx="2.5"/><path d="M9 8h6M9 12h6M9 16h4"/>' },
  { href: '/series/', text: '系列', icon: '<rect x="3.5" y="3.5" width="7" height="7" rx="2"/><rect x="13.5" y="3.5" width="7" height="7" rx="2"/><rect x="3.5" y="13.5" width="7" height="7" rx="2"/><rect x="13.5" y="13.5" width="7" height="7" rx="2"/>' },
  { href: '/posts/about/', text: '关于', icon: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20v-1.5a7 7 0 0 1 14 0V20"/>' },
  { href: '/posts/guestbook/', text: '留言', icon: '<path d="M20.5 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-3.5-.7L3.5 21l1.4-5a8.5 8.5 0 1 1 15.6-4.5Z"/><path d="M8 11.5h.01M12 11.5h.01M16 11.5h.01"/>' },
];
const normalizePath = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
const isCurrent = (href: string) => {
  const normalized = normalizePath(href);
  if (normalized === '/archive') return currentPath === normalized
    || currentPath.startsWith('/tags/') || currentPath.startsWith('/topics/')
    || (currentPath.startsWith('/posts/') && !['/posts/about', '/posts/guestbook'].includes(currentPath));
  return normalized === currentPath;
};
const currentValue = (href: string): 'page' | 'true' | undefined =>
  isCurrent(href) ? (normalizePath(href) === currentPath ? 'page' : 'true') : undefined;
---

<header class="site-header">
  <nav class="navigation glass" aria-label="主导航" data-liquid-glass data-glass-lens>
    <a href="/" class="brand" aria-label={site.name + '，返回首页'}>
      <span class="brand-mark" aria-hidden="true">y</span>
      <span>{site.name}</span>
    </a>
    <ul class="desktop-links capsule-track" data-capsule-track>
      <li class="nav-capsule" aria-hidden="true"></li>
      {navigation.map(({ href, text }) => (
        <li><a href={href} aria-current={currentValue(href)}>{text}</a></li>
      ))}
    </ul>
    <div class="nav-actions">
      <button type="button" class="nav-action search-trigger" aria-label="搜索文章" aria-haspopup="dialog" aria-controls="search-dialog" data-search-open>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
      </button>
      <button type="button" class="nav-action theme-button" id="theme-toggle" aria-label="切换深色主题" aria-pressed="false">
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 13.5A8.5 8.5 0 0 1 10.5 3.5a8.5 8.5 0 1 0 10 10Z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
      </button>
    </div>
  </nav>
</header>

<nav class="mobile-dock glass" aria-label="底部导航" data-liquid-glass data-glass-lens>
  <ul class="dock-links capsule-track" data-capsule-track>
    <li class="nav-capsule" aria-hidden="true"></li>
    {navigation.map(({ href, text, icon }) => (
      <li><a href={href} aria-current={currentValue(href)}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
        <span>{text}</span>
      </a></li>
    ))}
  </ul>
</nav>

<style>
  .site-header { position: sticky; top: 20px; z-index: 100; width: min(760px, calc(100% - 48px)); margin: 20px auto 0; }
  .navigation { display: flex; align-items: center; gap: 14px; padding: 7px 9px; border-radius: 999px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; padding: 0 12px 0 4px; color: var(--text); text-decoration: none; font-size: 18px; font-weight: 700; letter-spacing: -.05em; white-space: nowrap; }
  .brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; padding-bottom: 3px; color: #365f7d; background: linear-gradient(145deg, rgb(255 255 255 / .82), rgb(167 204 223 / .3)); box-shadow: inset 0 1px 1px #fff, 0 2px 7px #1a466c12; font-size: 24px; font-weight: 550; }
  .capsule-track { position: relative; isolation: isolate; list-style: none; margin: 0; padding: 0; }
  .desktop-links { display: flex; flex: 1; justify-content: center; gap: 2px; }
  .capsule-track > li:not(.nav-capsule) { position: relative; z-index: 1; min-width: 0; }
  .desktop-links a { display: flex; align-items: center; justify-content: center; min-height: 43px; padding: 0 15px; border-radius: 999px; color: var(--text-secondary); text-decoration: none; font-size: 13px; font-weight: 600; white-space: nowrap; transition: color .2s, transform .2s; }
  .capsule-track a[aria-current] { color: var(--blue); background: rgb(255 255 255 / .52); box-shadow: inset 0 1px 0 rgb(255 255 255 / .86), 0 2px 5px #244d6b08; }
  .capsule-track a:hover { color: var(--blue); }
  .capsule-track a:active { transform: scale(.95); }
  .capsule-track a:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .nav-capsule { position: absolute; z-index: 0; top: 0; left: 0; width: var(--capsule-width, 0px); height: var(--capsule-height, 43px); border-radius: 999px; background: linear-gradient(145deg, rgb(255 255 255 / .7), rgb(255 255 255 / .28)); box-shadow: inset 0 1px 1px #fff, inset 0 -1px 1px #6490af10, 0 3px 9px #2751700a; border: 1px solid rgb(255 255 255 / .64); transform: translate3d(var(--capsule-x, 0px), var(--capsule-y, 0px), 0); opacity: 0; pointer-events: none; }
  .capsule-track.is-enhanced .nav-capsule { opacity: 1; }
  .capsule-track.is-enhanced a[aria-current] { background: transparent; box-shadow: none; }
  .capsule-track.is-moving .nav-capsule { transition: transform .48s cubic-bezier(.18, 1.08, .32, 1), width .48s cubic-bezier(.18, 1.08, .32, 1), height .3s ease; }
  .nav-actions { display: flex; align-items: center; gap: 2px; }
  .nav-action { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; color: var(--text-secondary); background: transparent; cursor: pointer; transition: color .2s, background .2s, transform .25s cubic-bezier(.18, 1.1, .3, 1); }
  .nav-action:hover { color: var(--blue); background: rgb(255 255 255 / .3); }
  .nav-action:active { transform: scale(.88); background: rgb(255 255 255 / .55); }
  .nav-action svg, .dock-links svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .icon-sun { display: none; }
  .mobile-dock { display: none; }
  :global(html[data-theme="dark"]) .icon-moon { display: none; }
  :global(html[data-theme="dark"]) .icon-sun { display: block; }
  :global(html[data-theme="dark"]) .brand-mark { color: #c0daed; background: linear-gradient(145deg, rgb(177 211 231 / .25), rgb(87 127 154 / .16)); box-shadow: inset 0 1px 1px #ffffff4a, 0 2px 7px #0002; }
  :global(html[data-theme="dark"]) .nav-capsule { background: linear-gradient(145deg, rgb(211 232 248 / .19), rgb(187 213 232 / .06)); border-color: rgb(223 240 253 / .16); box-shadow: inset 0 1px 0 #ffffff35, inset 0 -1px 1px #12253330, 0 3px 9px #0002; }
  :global(html[data-theme="dark"]) .capsule-track:not(.is-enhanced) a[aria-current] { background: rgb(255 255 255 / .1); box-shadow: inset 0 1px 0 #ffffff26; }
  :global(html[data-theme="dark"]) .nav-action:hover { background: rgb(255 255 255 / .08); }
  :global(html[data-theme="dark"]) .nav-action:active { background: rgb(255 255 255 / .14); }
  :global(html:not(.js)) .search-trigger, :global(html:not(.js)) .theme-button { display: none; }
  @media (max-width: 760px) and (min-width: 681px) {
    .navigation { gap: 5px; }
    .brand { padding-right: 6px; gap: 7px; }
    .desktop-links a { padding-inline: 11px; }
  }
  @media (max-width: 680px) {
    .site-header { top: calc(12px + env(safe-area-inset-top, 0px)); width: calc(100% - 32px); margin-top: calc(12px + env(safe-area-inset-top, 0px)); }
    .navigation { justify-content: space-between; gap: 10px; padding: 5px 8px; }
    .brand { gap: 8px; padding-right: 6px; font-size: 17px; }
    .brand-mark { width: 32px; height: 32px; font-size: 23px; }
    .desktop-links { display: none; }
    .mobile-dock { display: block; position: fixed; z-index: 110; left: 50%; bottom: calc(14px + env(safe-area-inset-bottom, 0px)); width: min(420px, calc(100% - 32px)); padding: 5px; border-radius: 999px; transform: translateX(-50%); }
    .dock-links { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 2px; }
    .dock-links a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; min-height: 58px; padding: 6px 3px; border-radius: 999px; color: var(--text-secondary); text-decoration: none; font-size: 10px; line-height: 1.2; font-weight: 550; letter-spacing: .01em; transition: color .2s, transform .2s; }
    .dock-links a[aria-current] { color: var(--blue); }
    .dock-links a[aria-current] svg { stroke-width: 1.9; }
    .dock-links svg { width: 21px; height: 21px; }
    .dock-links .nav-capsule { border-radius: 999px; }
  }
  @media (max-width: 360px) {
    .mobile-dock { width: calc(100% - 24px); bottom: calc(10px + env(safe-area-inset-bottom, 0px)); }
    .dock-links a { min-height: 56px; font-size: 9px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .capsule-track.is-moving .nav-capsule, .capsule-track a, .nav-action { transition: none; }
  }
  @media (prefers-contrast: more) {
    .nav-capsule { border-color: var(--text-secondary); background: var(--surface-solid); }
    .capsule-track a[aria-current] { font-weight: 750; }
  }
</style>
