<dialog class="search-dialog glass" id="search-dialog" aria-labelledby="search-heading" data-liquid-glass>
  <div class="search-panel">
    <div class="search-topline">
      <div class="search-heading-wrap"><p class="search-kicker">在笔记里寻找</p><h2 id="search-heading">你想读些什么？</h2></div>
      <button type="button" class="search-close" id="search-close" aria-label="关闭搜索"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"/></svg></button>
    </div>
    <label class="search-input-wrap" for="site-search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
      <input id="site-search" type="search" aria-label="搜索文章关键词" placeholder="搜索标题、标签或系列…" autocomplete="off" spellcheck="false" aria-controls="search-results" aria-describedby="search-status" />
      <kbd aria-hidden="true">esc</kbd>
    </label>
    <div class="search-status-row"><p id="search-status" role="status" aria-live="polite">输入关键词，寻找一篇文章。</p><button type="button" id="search-retry" hidden>重新加载</button></div>
    <ul class="search-results" id="search-results" aria-label="文章搜索结果"></ul>
    <div class="search-empty" id="search-empty" hidden><span aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="21" cy="21" r="11"/><path d="m29 29 9 9M17 21h8"/></svg></span><p>还没有找到相关内容</p><small>换一个短词试试，比如「学习」「CNN」。</small></div>
    <div class="search-bottomline"><span>每一次好奇，都有迹可循。</span><span class="keyboard-hint"><span><kbd>↑</kbd><kbd>↓</kbd> 浏览</span><span><kbd>↵</kbd> 打开</span></span></div>
  </div>
</dialog>

<style>
  :global(html.search-open) { overflow: hidden; }
  .search-dialog {
    --search-fill: rgb(246 250 255 / .79);
    --search-field: rgb(255 255 255 / .58);
    --search-highlight: rgb(255 255 255 / .5);
    width: min(660px, calc(100% - 40px));
    max-height: min(740px, calc(var(--search-viewport-height, 100dvh) - 72px));
    margin: clamp(36px, 9dvh, 100px) auto auto;
    padding: 0;
    color: var(--text);
    background: linear-gradient(145deg, rgb(255 255 255 / .18), transparent 48%), var(--search-fill);
    border: 1px solid rgb(255 255 255 / .64);
    border-radius: 32px;
    box-shadow: 0 32px 100px rgb(18 43 69 / .18), 0 9px 24px rgb(18 43 69 / .08), inset 0 1px 0 rgb(255 255 255 / .93), inset 0 -1px 0 rgb(77 107 139 / .13);
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    overflow: hidden;
    transform-origin: var(--search-origin-x, 82%) 0;
  }
  .search-dialog::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(ellipse at var(--glass-x, 78%) var(--glass-y, 0%), var(--search-highlight), transparent 62%);
    box-shadow: inset 1px 1px 0 rgb(255 255 255 / .24), inset -1px -1px 0 rgb(255 255 255 / .12);
  }
  .search-dialog[open] { animation: search-arrive 280ms cubic-bezier(.16, 1, .3, 1) both; }
  .search-dialog::backdrop { background: rgb(27 43 64 / .17); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); }
  .search-dialog[open]::backdrop { animation: search-backdrop-arrive 220ms ease both; }
  .search-dialog[open].is-closing { animation: search-leave 160ms ease-in both; pointer-events: none; }
  .search-dialog[open].is-closing::backdrop { animation: search-backdrop-leave 160ms ease-in both; }
  .search-panel { position: relative; z-index: 1; display: flex; flex-direction: column; max-height: inherit; padding: 25px 25px 0; }
  .search-topline { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
  .search-kicker { color: var(--text-tertiary); font-size: 11px; line-height: 1.5; letter-spacing: .08em; margin: 0 0 5px; }
  .search-topline h2 { font-size: 23px; letter-spacing: -.045em; font-weight: 650; line-height: 1.3; margin: 0; }
  .search-close { width: 44px; height: 44px; flex-shrink: 0; display: grid; place-items: center; margin: -9px -4px 0 0; color: var(--text-secondary); background: rgb(106 134 163 / .08); box-shadow: inset 0 1px 0 rgb(255 255 255 / .55); border: 1px solid rgb(106 134 163 / .08); border-radius: 50%; cursor: pointer; transition: background .18s, transform .2s; }
  .search-close:hover { color: var(--text); background: rgb(106 134 163 / .14); }
  .search-close:active { transform: scale(.92); }
  .search-close svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; }
  .search-input-wrap { display: flex; align-items: center; gap: 12px; min-height: 58px; flex-shrink: 0; padding: 0 16px; border: 1px solid rgb(122 151 180 / .16); border-radius: 19px; background: var(--search-field); box-shadow: inset 0 1px 2px rgb(42 67 98 / .035), 0 1px 0 rgb(255 255 255 / .5); transition: border-color .18s, box-shadow .18s, background .18s; }
  .search-input-wrap:focus-within { border-color: rgb(67 132 192 / .49); background: rgb(255 255 255 / .76); box-shadow: 0 0 0 3px rgb(91 147 191 / .09), inset 0 1px 0 rgb(255 255 255 / .8); }
  .search-input-wrap > svg { width: 21px; height: 21px; fill: none; stroke: var(--blue); stroke-width: 1.65; stroke-linecap: round; flex-shrink: 0; }
  .search-input-wrap input { appearance: none; min-width: 0; width: 100%; flex: 1; border: 0; padding: 15px 0; background: transparent; font: inherit; font-size: 16px; color: var(--text); outline: none; }
  .search-input-wrap input::placeholder { color: var(--text-tertiary); opacity: .9; }
  kbd { display: inline-grid; place-items: center; min-width: 19px; height: 19px; font-family: inherit; font-size: 10px; line-height: 1; color: var(--text-tertiary); padding: 2px 4px; background: rgb(255 255 255 / .24); border: 1px solid rgb(98 126 155 / .15); border-radius: 5px; box-shadow: 0 1px 0 rgb(98 126 155 / .06); }
  .search-status-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-shrink: 0; min-height: 44px; margin: 8px 3px 2px; }
  .search-status-row p { margin: 0; font-size: 11px; font-weight: 500; color: var(--text-tertiary); }
  .search-status-row button { min-height: 40px; border: 0; background: transparent; color: var(--blue); font: inherit; font-size: 12px; cursor: pointer; }
  .search-results { list-style: none; padding: 0 5px 2px 0; margin: 0 -5px 0 0; overflow-y: auto; min-height: 0; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: rgb(94 125 154 / .23) transparent; }
  .search-results :global(li + li) { margin-top: 3px; }
  .search-results :global(.search-result) { position: relative; display: flex; flex-direction: column; gap: 7px; padding: 16px 17px; border: 1px solid transparent; border-radius: 18px; text-decoration: none; color: var(--text); transition: background .18s, border-color .18s, box-shadow .18s; }
  .search-results :global(.search-result:hover), .search-results :global(.search-result:focus-visible) { background: rgb(255 255 255 / .43); border-color: rgb(255 255 255 / .63); box-shadow: 0 3px 14px rgb(48 80 113 / .035); }
  .search-results :global(.search-result:focus-visible) { outline-offset: -3px; }
  .search-results :global(.search-result-label) { font-size: 10px; line-height: 1.5; font-weight: 550; color: var(--blue); }
  .search-results :global(.search-result-title) { font-size: 15px; letter-spacing: -.015em; line-height: 1.55; font-weight: 600; }
  .search-results :global(.search-result-excerpt) { font-size: 12px; line-height: 1.75; color: var(--text-secondary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .search-empty { padding: 29px 8px 39px; text-align: center; color: var(--text-secondary); }
  .search-empty > span { display: grid; place-items: center; width: 60px; height: 60px; margin: 0 auto 10px; border: 1px solid rgb(122 151 180 / .13); border-radius: 22px; background: rgb(255 255 255 / .28); color: var(--text-tertiary); }
  .search-empty svg { width: 39px; height: 39px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .search-empty p { margin: 0 0 7px; font-size: 14px; }
  .search-empty small { font-size: 12px; color: var(--text-tertiary); }
  .search-bottomline { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-shrink: 0; margin-top: 13px; padding: 17px 3px 19px; border-top: 1px solid rgb(98 126 155 / .1); font-size: 10px; line-height: 1.6; color: var(--text-tertiary); }
  .keyboard-hint, .keyboard-hint > span { display: flex; align-items: center; gap: 4px; white-space: nowrap; }
  .keyboard-hint { gap: 13px; }
  :global(html[data-theme="dark"]) .search-dialog { --search-fill: rgb(22 37 55 / .84); --search-field: rgb(10 22 36 / .38); --search-highlight: rgb(188 220 255 / .09); border-color: rgb(203 225 249 / .22); box-shadow: 0 32px 100px rgb(0 8 20 / .4), 0 9px 24px rgb(0 8 20 / .17), inset 0 1px 0 rgb(220 237 255 / .17), inset 0 -1px 0 rgb(0 0 0 / .15); }
  :global(html[data-theme="dark"]) .search-dialog::before { box-shadow: inset 1px 1px 0 rgb(234 244 255 / .05), inset -1px -1px 0 rgb(234 244 255 / .04); }
  :global(html[data-theme="dark"]) .search-dialog::backdrop { background: rgb(0 8 20 / .35); }
  :global(html[data-theme="dark"]) .search-close { color: var(--text-secondary); background: rgb(200 223 250 / .08); border-color: rgb(200 223 250 / .07); box-shadow: inset 0 1px 0 rgb(226 240 255 / .06); }
  :global(html[data-theme="dark"]) .search-close:hover { background: rgb(200 223 250 / .13); }
  :global(html[data-theme="dark"]) .search-input-wrap { border-color: rgb(200 223 250 / .11); box-shadow: inset 0 1px 3px rgb(0 0 0 / .08), 0 1px 0 rgb(226 240 255 / .045); }
  :global(html[data-theme="dark"]) .search-input-wrap:focus-within { border-color: rgb(124 183 241 / .5); background: rgb(10 22 36 / .53); box-shadow: 0 0 0 3px rgb(130 186 255 / .08); }
  :global(html[data-theme="dark"]) kbd { background: rgb(218 236 255 / .045); border-color: rgb(200 223 250 / .16); }
  :global(html[data-theme="dark"]) .search-results :global(.search-result:hover), :global(html[data-theme="dark"]) .search-results :global(.search-result:focus-visible) { background: rgb(173 208 244 / .07); border-color: rgb(173 208 244 / .1); box-shadow: 0 3px 14px rgb(0 0 0 / .04); }
  :global(html[data-theme="dark"]) .search-empty > span { background: rgb(173 208 244 / .045); border-color: rgb(173 208 244 / .1); }
  :global(html[data-theme="dark"]) .search-bottomline { border-color: rgb(173 208 244 / .1); }
  @keyframes search-arrive { from { opacity: 0; transform: translateY(-13px) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @keyframes search-leave { from { opacity: 1; transform: translateY(0) scale(1); } to { opacity: 0; transform: translateY(-8px) scale(.98); } }
  @keyframes search-backdrop-arrive { from { opacity: 0; } to { opacity: 1; } }
  @keyframes search-backdrop-leave { from { opacity: 1; } to { opacity: 0; } }
  @media (max-width: 680px) {
    .search-dialog { width: calc(100% - 24px); max-height: min(720px, calc(var(--search-viewport-height, 100dvh) - 32px - env(safe-area-inset-top))); margin: max(16px, env(safe-area-inset-top)) auto auto; border-radius: 27px; transform-origin: var(--search-origin-x, 50%) 0; }
    .search-panel { padding: 21px 17px 0; }
    .search-topline { margin-bottom: 19px; }
    .search-kicker { font-size: 10px; }
    .search-topline h2 { font-size: 21px; }
    .search-input-wrap { min-height: 55px; padding-inline: 13px; gap: 10px; border-radius: 17px; }
    .search-input-wrap input { padding-block: 14px; }
    .search-status-row { min-height: 42px; }
    .search-results :global(.search-result) { padding: 14px 12px; }
    .search-results :global(.search-result-title) { font-size: 14px; }
    .search-bottomline { padding: 15px 3px 17px; margin-top: 9px; }
    .search-input-wrap > kbd, .keyboard-hint { display: none; }
    .search-dialog[open] { animation-duration: 240ms; }
  }
  @media (prefers-reduced-motion: reduce) {
    .search-dialog[open], .search-dialog[open]::backdrop, .search-dialog[open].is-closing, .search-dialog[open].is-closing::backdrop { animation: none; }
    .search-close, .search-input-wrap, .search-results :global(.search-result) { transition: none; }
    .search-close:active { transform: none; }
  }
  @media (prefers-contrast: more), (prefers-reduced-transparency: reduce) {
    .search-dialog { --search-fill: #f6faff; --search-field: #fff; --search-highlight: transparent; border-color: #637b94; backdrop-filter: none; -webkit-backdrop-filter: none; }
    :global(html[data-theme="dark"]) .search-dialog { --search-fill: #162537; --search-field: #0a1624; --search-highlight: transparent; border-color: #9aafc6; }
    .search-dialog::backdrop { backdrop-filter: none; -webkit-backdrop-filter: none; }
    .search-input-wrap, .search-bottomline { border-color: var(--text-tertiary); }
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .search-dialog { --search-fill: #f6faff; --search-field: #fff; }
    :global(html[data-theme="dark"]) .search-dialog { --search-fill: #162537; --search-field: #0a1624; }
    .search-dialog::backdrop { background: rgb(27 43 64 / .32); }
  }
</style>
