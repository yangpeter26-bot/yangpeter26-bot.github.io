---
import Layout from '../layouts/Layout.astro';
import { getPublishedPosts } from '../lib/posts';
import { groupPostsBySeries } from '../lib/series';
const series = groupPostsBySeries(await getPublishedPosts());
---

<Layout title="学习系列" description="把零散笔记串起来，按顺序阅读 yyg 的安全与深度学习系列。">
  <header class="page-heading">
    <p class="eyebrow">连接知识的线索</p>
    <h1>循序渐进<span>。</span></h1>
    <p>把一个主题慢慢学透。选择一个系列，从第一篇开始。</p>
  </header>
  <div class="series-grid">
    {series.map((group) => (
      <section class="series-card surface" id={group.id} aria-labelledby={`series-${group.id}`}>
        <header>
          <span class="series-symbol" aria-hidden="true">{group.icon}</span>
          <span class="series-count">{group.posts.length} 篇笔记</span>
          <h2 id={`series-${group.id}`}>{group.title}</h2>
          <p>{group.description}</p>
        </header>
        <ol>
          {group.posts.map((post, index) => (
            <li><a href={`/posts/${post.id}/`}><span class="chapter-number">{String(index + 1).padStart(2, '0')}</span><span>{post.data.title}</span><span class="chapter-arrow" aria-hidden="true">↗</span></a></li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Layout>

<style>
  .page-heading { padding: 42px 0 34px; }
  .page-heading h1 { margin: 10px 0 16px; font-size: clamp(36px, 5vw, 52px); line-height: 1.15; letter-spacing: -.06em; }
  .page-heading h1 span { color: var(--blue); }
  .page-heading > p:last-child { color: var(--text-secondary); font-size: 16px; line-height: 1.8; }
  .series-grid { display: grid; gap: 22px; }
  .series-card { padding: 30px 34px 12px; scroll-margin-top: 110px; }
  .series-card header { position: relative; padding-right: 90px; padding-bottom: 26px; }
  .series-symbol { display: inline-grid; place-items: center; width: 45px; height: 45px; border-radius: 14px; color: var(--blue); background: color-mix(in srgb, var(--blue) 9%, transparent); font-size: 25px; margin-bottom: 18px; }
  .series-count { position: absolute; top: 12px; right: 0; font-size: 12px; color: var(--text-tertiary); }
  .series-card h2 { font-size: 23px; letter-spacing: -.04em; line-height: 1.5; margin-bottom: 10px; }
  .series-card header p { color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { border-top: 1px solid var(--border); }
  li a { display: grid; grid-template-columns: 28px 1fr 18px; gap: 13px; align-items: baseline; padding: 18px 0; font-size: 14px; line-height: 1.8; color: var(--text); text-decoration: none; }
  li a:hover { color: var(--blue); }
  .chapter-number { color: var(--text-tertiary); font-variant-numeric: tabular-nums; font-size: 12px; }
  .chapter-arrow { color: var(--text-tertiary); }
  @media (max-width: 640px) { .page-heading { padding-top: 30px; } .series-card { padding: 24px 21px 8px; } .series-card header { padding-right: 0; } .series-card h2 { font-size: 20px; } li a { gap: 9px; font-size: 13px; } }
</style>
