---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, type Post } from '../../lib/posts';
import { getTopic, TOPICS } from '../../lib/topics';

export const getStaticPaths = (async () => {
  const all = await getPublishedPosts();
  return TOPICS.map((topic) => ({ params: { topic: topic.id }, props: { topic, posts: all.filter((post) => getTopic(post).tone === topic.id) } }));
}) satisfies GetStaticPaths;
interface Props { topic: typeof TOPICS[number]; posts: Post[] }
const { topic, posts } = Astro.props;
---
<Layout title={topic.label} description={topic.description} wide>
  <section class="topic-page">
    <a class="back-link" href="/">← 返回首页</a>
    <header class="topic-heading"><p class="eyebrow">EXPLORE NOTES</p><h1>{topic.label}</h1><p>{topic.description}<span>共 {posts.length} 篇笔记</span></p></header>
    <nav class="topic-switch" aria-label="笔记方向">{TOPICS.map((item) => <a href={`/topics/${item.id}/`} aria-current={topic.id === item.id ? 'page' : undefined}>{item.label}</a>)}</nav>
    <div class="posts-grid">{posts.map((post) => <PostCard post={post} />)}</div>
  </section>
</Layout>
<style>
  .topic-page { padding-top: 32px; }
  .topic-heading { padding-block: 25px; }
  h1 { font-size: clamp(28px,4vw,40px); letter-spacing: -.045em; margin: 8px 0 12px; }
  .topic-heading > p:last-child { color: var(--text-secondary); font-size: 14px; }
  .topic-heading span { display: inline-block; margin-left: 16px; font-size: 12px; color: var(--text-tertiary); }
  .topic-switch { display: flex; gap: 7px; flex-wrap: wrap; margin: 0 0 26px; }
  .topic-switch a { padding: 9px 15px; border-radius: 999px; text-decoration: none; color: var(--text-secondary); font-size: 12px; }
  .topic-switch a[aria-current='page'] { background: var(--surface); color: var(--blue); box-shadow: 0 2px 7px rgba(43,65,91,.04); border: 1px solid var(--border); }
  @media(max-width:640px) { .topic-heading > p:last-child { font-size: 12px; } .topic-heading span { display: block; margin: 8px 0 0; } }
</style>
